[Unit]
Description=sandssh wss relay (mode B rendezvous)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/sandssh-relay.env
ExecStart=/usr/local/bin/sandssh-relay --listen 127.0.0.1:8443
User=sandssh
Group=sandssh
Restart=always
RestartSec=2
# the relay is a dumb pipe: no filesystem access needed beyond its own env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
