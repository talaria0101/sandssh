 }
 
@@ -230,3 +240,16 @@ func defaultPath(u *user.User) string {
 	gossh.TTY_OP_ISPEED: "tty_op_ispeed",
 	gossh.TTY_OP_OSPEED: "tty_op_ospeed",
 }
+
+// canOpenPTY reports whether the host can provide a kernel pty.
+// Sandboxed environments may have none; sessions then fall back to
+// pipes (gliderssh's NL->CRNL emulation stays enabled for output).
+func canOpenPTY() bool {
+	ptmx, tty, err := pty.Open()
+	if err != nil {
+		return false
+	}
+	ptmx.Close()
+	tty.Close()
+	return true
+}
